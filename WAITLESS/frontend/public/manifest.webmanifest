{
  "name": "WaitLess OS",
  "short_name": "WaitLess",
  "description": "Hospital queue management — check in, track your ticket, and get turn alerts.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#020814",
  "theme_color": "#0f766e",
  "categories": ["medical", "productivity"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Track my ticket",
      "url": "/track",
      "description": "Check live queue position and estimated wait",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Check in",
      "url": "/self-register",
      "description": "Get a queue ticket from your phone",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}

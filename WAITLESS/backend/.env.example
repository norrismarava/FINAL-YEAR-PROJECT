PORT=4242
CORS_ORIGIN=*
PUBLIC_APP_URL=http://localhost:5173

# Data storage
# Staff authentication and hospital deployment use MySQL.
DB_PROVIDER=mysql
STATE_FILE_PATH=backend/data/queue-state.json
# Used by the append-only audit trail when DB_PROVIDER=file.
AUDIT_LOG_PATH=backend/data/audit-events.jsonl
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=waitless_
DB_USER=waitless
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SEED_DEMO_DATA=true

# Staff access
AUTH_SESSION_TTL_MS=28800000

# Used only when the database has no administrator. Remove the password after
# the first successful startup. Never commit a real password.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@waitless.local
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_PASSWORD=

# Notification transport
WHATSAPP_PROVIDER=mock
WHATSAPP_RETRY_DELAYS_MS=15000,60000,300000
WHATSAPP_MOCK_DELAY_MS=250
WHATSAPP_MOCK_FAILURE_RATE=0

# Meta WhatsApp Cloud API
# Switch WHATSAPP_PROVIDER to meta-cloud to enable live sends.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# Optional template names. If left blank, the integration falls back to text messages.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_QUEUE_REGISTERED=
WHATSAPP_TEMPLATE_QUEUE_READY_SOON=
WHATSAPP_TEMPLATE_QUEUE_CALLED=
